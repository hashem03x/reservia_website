# Reservia website -- public, build-time configuration.
#
# Every variable here is read client-side (Vite inlines VITE_* vars into
# the browser bundle), so NONE of these may ever be a secret, private
# token, or credential.
#
# Defaults for the business contact fields below (WhatsApp number,
# emails, office/mobile phone, address) are the real public values
# published in the supplied reference template (Reservia.html) -- see
# src/config/env.ts. They are safe defaults, not secrets, and are used
# automatically even if you don't set these. Override only if the real
# values change.

# --- Lead capture / CRM -----------------------------------------------
# Public URL of the lead-capture endpoint (ideally a backend proxy in
# front of the real CRM, not the CRM's API directly). When unset, both
# the contact form and the five campaign landing-page forms run in mock
# mode: submissions are logged to the console and are NOT delivered
# anywhere (the UI's own copy already discloses this -- see q_priv /
# lp_priv in the translation dictionaries).
VITE_LEADS_API_URL=

# --- Business contact (defaults already match the reference template) --
VITE_WHATSAPP_NUMBER=201211892995
VITE_BUSINESS_EMAIL=Business_info@reservia-energy.com
VITE_SALES_EMAIL=Reservia_Sales@reservia-energy.com
VITE_MOBILE_PHONE=+20 121 189 2995
VITE_OFFICE_PHONE=+20 2 2522 2814
VITE_WEBSITE_HOST=reservia-energy.com

# --- Site -----------------------------------------------------------
# Production domain, no trailing slash, e.g. https://www.reservia-energy.com
# Used for canonical URLs, hreflang alternates, and Open Graph tags. When
# unset, those tags are simply omitted rather than pointing at a guess.
VITE_SITE_URL=

# --- Analytics & tracking ------------------------------------------------
# Each of these activates its matching script only when set. None are
# invented -- replace with the real IDs once Reservia provides them.
VITE_GA4_MEASUREMENT_ID=
VITE_GTM_CONTAINER_ID=
VITE_META_PIXEL_ID=
VITE_GOOGLE_ADS_CONVERSION_ID=
